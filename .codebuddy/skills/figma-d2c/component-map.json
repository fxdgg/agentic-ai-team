{
  "version": "5.8.0",
  "mode": "project-first",
  "usageNote": "此文件定义 Figma 组件到代码组件的映射关系。rules 数组中 kind=project-component 的条目用于映射项目自定义组件，kind=component-library 的条目用于映射组件库组件。请根据项目实际情况添加映射规则。",
  "rules": [
    {
      "id": "button",
      "match": { "componentKeys": [], "namePatterns": ["Button", "Btn", "CTA", "Primary Button", "Text Button"] },
      "target": { "kind": "component-library", "importFrom": "{componentLibrary}", "componentName": "Button" },
      "props": {
        "theme": { "source": "variant", "mapping": { "Primary": "primary", "Secondary": "default", "Default": "default" } },
        "variant": { "source": "variant", "mapping": { "Text": "text", "Outline": "outline" } },
        "size": { "source": "size", "mapping": { "S": "small", "M": "medium", "L": "large" } }
      },
      "slots": { "default": "children", "icon": "prefixIcon" },
      "fallback": "native-button"
    },
    {
      "id": "breadcrumb",
      "match": { "componentKeys": [], "namePatterns": ["Breadcrumb", "面包屑"] },
      "target": { "kind": "component-library", "importFrom": "{componentLibrary}", "componentName": "Breadcrumb" },
      "props": {},
      "slots": { "items": "children" },
      "fallback": "native-nav"
    },
    {
      "id": "avatar",
      "match": { "componentKeys": [], "namePatterns": ["Avatar", "User Avatar", "头像"] },
      "target": { "kind": "component-library", "importFrom": "{componentLibrary}", "componentName": "Avatar" },
      "props": { "image": { "source": "image", "mapping": {} } },
      "slots": { "default": "children" },
      "fallback": "native-avatar"
    },
    {
      "id": "tag",
      "match": { "componentKeys": [], "namePatterns": ["Tag", "Label", "Badge", "标签", "徽标"] },
      "target": { "kind": "component-library", "importFrom": "{componentLibrary}", "componentName": "Tag" },
      "props": {
        "theme": { "source": "variant", "mapping": { "success": "success", "warning": "warning", "danger": "danger", "default": "default" } },
        "variant": { "source": "variant", "mapping": { "light": "light", "outline": "outline" } }
      },
      "slots": { "default": "children" },
      "fallback": "native-span"
    },
    {
      "id": "input",
      "match": { "componentKeys": [], "namePatterns": ["Input", "TextField", "Search", "输入框", "搜索框"] },
      "target": { "kind": "component-library", "importFrom": "{componentLibrary}", "componentName": "Input" },
      "props": { "placeholder": { "source": "text", "mapping": {} } },
      "slots": {},
      "fallback": "native-input"
    },
    {
      "id": "textarea",
      "match": { "componentKeys": [], "namePatterns": ["Textarea", "Comment Input", "多行输入", "评论输入"] },
      "target": { "kind": "component-library", "importFrom": "{componentLibrary}", "componentName": "Textarea" },
      "props": { "placeholder": { "source": "text", "mapping": {} } },
      "slots": {},
      "fallback": "native-textarea"
    },
    {
      "id": "select",
      "match": { "componentKeys": [], "namePatterns": ["Select", "Dropdown", "Picker", "选择器", "下拉选择"] },
      "target": { "kind": "component-library", "importFrom": "{componentLibrary}", "componentName": "Select" },
      "props": {},
      "slots": {},
      "fallback": "native-select"
    },
    {
      "id": "rate",
      "match": { "componentKeys": [], "namePatterns": ["Rate", "Rating", "Star Rating", "评分"] },
      "target": { "kind": "component-library", "importFrom": "{componentLibrary}", "componentName": "Rate" },
      "props": { "value": { "source": "value", "mapping": {} } },
      "slots": {},
      "fallback": "native-rating"
    },
    {
      "id": "loading",
      "match": { "componentKeys": [], "namePatterns": ["Loading", "Spinner", "加载", "加载中"] },
      "target": { "kind": "component-library", "importFrom": "{componentLibrary}", "componentName": "Loading" },
      "props": {},
      "slots": { "default": "children" },
      "fallback": "native-loading"
    }
  ]
}
