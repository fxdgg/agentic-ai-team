{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowRisks",
  "description": "需求工作流风险追踪文件 Schema",
  "type": "object",
  "required": ["risks"],
  "properties": {
    "risks": {
      "type": "array",
      "description": "风险条目列表",
      "items": {
        "type": "object",
        "required": ["id", "source", "question", "status", "priority", "impact", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "description": "风险唯一标识，格式: RISK-[A-Z]NNN（如 RISK-P001）",
            "pattern": "^RISK-[A-Z]\\d{3,}$",
            "examples": ["RISK-P001"]
          },
          "source": {
            "type": "string",
            "description": "风险来源阶段 ID",
            "enum": [
              "CLARIFY_PRODUCT",
              "CLARIFY_TECH",
              "CLARIFY_ARCH_BACKEND",
              "CLARIFY_ARCH_FRONTEND",
              "ANALYSE_PRODUCT",
              "ANALYSE_TECH",
              "ARCHITECT_BACKEND",
              "ARCHITECT_FRONTEND",
              "IMPLEMENT",
              "TEST",
              "ROLLBACK"
            ]
          },
          "question": {
            "type": "string",
            "description": "风险描述（澄清阶段为被跳过的问题原文）"
          },
          "status": {
            "type": "string",
            "enum": ["open", "mitigated", "accepted", "skipped"],
            "description": "风险状态: open=未处理, mitigated=已缓解, accepted=已接受, skipped=澄清跳过"
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "风险优先级: blocking→high, important→medium, recommended→low"
          },
          "impact": {
            "type": "string",
            "description": "风险影响描述"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间"
          },
          "resolvedAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "解决时间"
          },
          "resolution": {
            "type": ["string", "null"],
            "description": "解决方案描述"
          }
        }
      }
    }
  }
}
