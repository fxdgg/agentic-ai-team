{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeBaseline",
  "description": "知识基线输出格式。由 @knowledge-builder Agent 生成，将导入的项目知识标准化为系统可消费的格式。",
  "type": "object",
  "required": ["metadata", "baseline"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["projectName", "importedAt", "sourceProfile", "overallConfidence"],
      "properties": {
        "projectName": {
          "type": "string",
          "description": "项目名称"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time",
          "description": "导入时间"
        },
        "sourceProfile": {
          "type": "string",
          "description": "代码画像来源文件路径"
        },
        "sourceDocCollection": {
          "type": ["string", "null"],
          "description": "文档收集来源文件路径（直接扫描模式下为 null）"
        },
        "overallConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "整体置信度（导入知识初始为 0.5-0.6）"
        }
      }
    },
    "baseline": {
      "type": "object",
      "description": "知识基线（对齐 _baseline-summary.json 的 4 维度格式）",
      "properties": {
        "baselineUserStories": {
          "type": "array",
          "description": "用户故事基线（从 businessModules 推导）",
          "items": {
            "type": "object",
            "required": ["id", "summary"],
            "properties": {
              "id": {
                "type": "string",
                "description": "用户故事 ID，格式: US-IMP-{序号}",
                "pattern": "^US-IMP-\\d{3}$"
              },
              "summary": {
                "type": "string",
                "description": "用户故事概要"
              },
              "module": {
                "type": "string",
                "description": "关联的模块名"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "置信度"
              }
            }
          }
        },
        "baselineBusinessRules": {
          "type": "array",
          "description": "业务规则基线（从文档 + 代码约定推导）",
          "items": {
            "type": "object",
            "required": ["id", "rule"],
            "properties": {
              "id": {
                "type": "string",
                "description": "业务规则 ID，格式: BR-IMP-{序号}",
                "pattern": "^BR-IMP-\\d{3}$"
              },
              "rule": {
                "type": "string",
                "description": "业务规则描述"
              },
              "source": {
                "type": "string",
                "enum": ["code", "document", "inferred"],
                "description": "规则来源"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "置信度"
              }
            }
          }
        },
        "baselineDataEntities": {
          "type": "array",
          "description": "数据实体基线（直接引用 codebase-profile.dataEntities）",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "description": "实体名"
              },
              "keyAttributes": {
                "type": "array",
                "items": { "type": "string" },
                "description": "核心字段"
              },
              "stateFlow": {
                "type": ["string", "null"],
                "description": "状态流转描述"
              }
            }
          }
        },
        "baselineUIPatterns": {
          "type": "array",
          "description": "UI 模式基线（从前端代码结构推导，可能为空）",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "UI 模式描述"
              },
              "pages": {
                "type": "array",
                "items": { "type": "string" },
                "description": "使用该模式的页面列表"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "置信度"
              }
            }
          }
        }
      }
    },
    "crossValidation": {
      "type": "object",
      "description": "文档 vs 代码交叉校验结果",
      "properties": {
        "docVsCodeConsistency": {
          "type": "string",
          "enum": ["consistent", "partial-mismatch", "significant-mismatch"],
          "description": "一致性评估"
        },
        "mismatches": {
          "type": "array",
          "description": "不一致项列表",
          "items": {
            "type": "object",
            "properties": {
              "dimension": {
                "type": "string",
                "description": "不一致的维度"
              },
              "docSays": {
                "type": "string",
                "description": "文档描述"
              },
              "codeSays": {
                "type": "string",
                "description": "代码实际"
              },
              "resolution": {
                "type": "string",
                "description": "解决策略",
                "default": "使用代码检测结果"
              }
            }
          }
        }
      }
    }
  }
}
