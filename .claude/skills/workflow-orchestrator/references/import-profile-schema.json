{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodebaseProfile",
  "description": "代码画像输出格式。由 @codebase-profiler Agent 生成，描述项目的全景架构、业务模块、数据模型和依赖关系。",
  "type": "object",
  "required": ["metadata", "projectOverview", "businessModules", "dataEntities", "dependencies", "codeMetrics"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["projectName", "profiledAt", "searchBudgetUsed", "searchBudgetTotal"],
      "properties": {
        "projectName": {
          "type": "string",
          "description": "项目名称"
        },
        "profiledAt": {
          "type": "string",
          "format": "date-time",
          "description": "画像生成时间"
        },
        "searchBudgetUsed": {
          "type": "integer",
          "minimum": 0,
          "description": "已使用的搜索次数"
        },
        "searchBudgetTotal": {
          "type": "integer",
          "minimum": 1,
          "description": "搜索总预算",
          "default": 60
        }
      }
    },
    "projectOverview": {
      "type": "object",
      "description": "项目全景概览，格式对齐 tech-exploration-schema.json",
      "required": ["modules", "techStack"],
      "properties": {
        "modules": {
          "type": "array",
          "description": "模块列表",
          "items": {
            "type": "object",
            "required": ["name", "type", "path"],
            "properties": {
              "name": {
                "type": "string",
                "description": "模块名称"
              },
              "type": {
                "type": "string",
                "enum": ["backend-service", "frontend-web", "frontend-miniprogram", "common-lib", "gateway", "config", "other"],
                "description": "模块类型"
              },
              "path": {
                "type": "string",
                "description": "模块路径（相对项目根）"
              },
              "description": {
                "type": "string",
                "description": "模块功能简述"
              },
              "subModules": {
                "type": "array",
                "items": { "type": "string" },
                "description": "子模块列表"
              }
            }
          }
        },
        "techStack": {
          "type": "object",
          "description": "技术栈版本映射（key=技术名, value=版本信息）",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "description": "版本号"
              },
              "source": {
                "type": "string",
                "description": "检测来源文件"
              }
            }
          }
        },
        "conventions": {
          "type": "array",
          "description": "项目约定列表",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["naming", "structure", "api", "config", "other"],
                "description": "约定类型"
              },
              "content": {
                "type": "string",
                "description": "约定描述"
              },
              "evidence": {
                "type": "string",
                "description": "发现此约定的代码位置"
              }
            }
          }
        }
      }
    },
    "businessModules": {
      "type": "array",
      "description": "业务模块列表",
      "items": {
        "type": "object",
        "required": ["name", "module"],
        "properties": {
          "name": {
            "type": "string",
            "description": "业务模块名"
          },
          "module": {
            "type": "string",
            "description": "关联的技术模块名（projectOverview.modules[].name）"
          },
          "functionalKeywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "功能关键词列表"
          },
          "apiEndpoints": {
            "type": "array",
            "description": "API 端点列表",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]
                },
                "path": { "type": "string" },
                "handler": {
                  "type": "string",
                  "description": "处理器（Controller.method）"
                }
              }
            }
          },
          "description": {
            "type": "string",
            "description": "模块功能概要"
          }
        }
      }
    },
    "dataEntities": {
      "type": "array",
      "description": "数据实体列表（对齐 _baseline-summary.json 的 baselineDataEntities 格式）",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "实体名"
          },
          "tableName": {
            "type": ["string", "null"],
            "description": "数据库表名"
          },
          "keyAttributes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "核心字段列表"
          },
          "relationships": {
            "type": "array",
            "items": { "type": "string" },
            "description": "实体关系描述（如 'Order 1:N OrderItem'）"
          },
          "stateFlow": {
            "type": ["string", "null"],
            "description": "状态流转描述"
          },
          "sourceFile": {
            "type": "string",
            "description": "来源文件（相对路径）"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "description": "依赖关系图谱",
      "properties": {
        "internal": {
          "type": "array",
          "description": "内部依赖（模块间）",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "description": "依赖方模块" },
              "to": { "type": "string", "description": "被依赖方模块" },
              "type": {
                "type": "string",
                "enum": ["maven-dependency", "feign", "rpc", "mq", "import", "other"],
                "description": "依赖类型"
              }
            }
          }
        },
        "external": {
          "type": "array",
          "description": "外部依赖（第三方库）",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "库名" },
              "version": { "type": "string", "description": "版本号" },
              "purpose": { "type": "string", "description": "用途推断" }
            }
          }
        }
      }
    },
    "codeMetrics": {
      "type": "object",
      "description": "代码质量指标（轻量级）",
      "properties": {
        "totalLines": {
          "type": "integer",
          "minimum": 0,
          "description": "估算总代码行数"
        },
        "moduleCount": {
          "type": "integer",
          "minimum": 0,
          "description": "模块总数"
        },
        "testDirectoryExists": {
          "type": "boolean",
          "description": "是否存在测试目录"
        },
        "estimatedComplexity": {
          "type": "string",
          "enum": ["small", "medium", "large", "enterprise"],
          "description": "估算项目规模：small(<5K行), medium(5K-30K), large(30K-100K), enterprise(>100K)"
        }
      }
    }
  }
}
